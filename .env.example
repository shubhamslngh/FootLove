# Local development and production use separate MySQL databases.
DATABASE_MODE=mysql

# Required only when DATABASE_MODE=mysql.
DATABASE_URL=mysql://footlove_local:LOCAL_PASSWORD@127.0.0.1:3306/footlove_local
DB_CONNECTION_LIMIT=5
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_BOOTSTRAP_FROM_FILE=false

APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

ADMIN_NAME=FootLove Admin
ADMIN_USERNAME=admin
ADMIN_PHONE=9876543210
ADMIN_PASSWORD=123456
